{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/site.(css|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)\\.mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/:path*", "destination": "/app.html" },
    { "source": "/interview", "destination": "/app.html" },
    { "source": "/interview/:path*", "destination": "/app.html" },
    { "source": "/exam", "destination": "/app.html" },
    { "source": "/exam/:path*", "destination": "/app.html" },
    { "source": "/knowledge", "destination": "/app.html" },
    { "source": "/knowledge/:path*", "destination": "/app.html" },
    { "source": "/billing", "destination": "/app.html" },
    { "source": "/billing/:path*", "destination": "/app.html" },
    { "source": "/settings", "destination": "/app.html" },
    { "source": "/settings/:path*", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" },
    { "source": "/admin/:path*", "destination": "/app.html" }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  }
}
