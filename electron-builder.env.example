# Copy this file to electron-builder.env after you have Apple Developer credentials.
# Do not commit electron-builder.env.

# Recommended: App Store Connect API key notarization.
# Create this in App Store Connect > Users and Access > Integrations > App Store Connect API.
# Save the downloaded .p8 key outside git and point APPLE_API_KEY at it.
APPLE_API_KEY=/absolute/path/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000

# electron-builder will sign with the Developer ID Application certificate
# installed in your macOS login keychain.
# Example identity:
# Developer ID Application: Your Name or Company (TEAMID1234)
